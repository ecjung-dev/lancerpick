# Copy this file to local-application.properties and enter your local DB values.
# Replace the port and database name if needed. Do not commit actual credentials.
DB_URL=jdbc:mysql://localhost:3306/lancerpick?connectionTimeZone=UTC
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Optional preparation for Toss test payments. Actual keys are provided separately.
# Keep the secret key in local-application.properties only; never commit its value.
TOSS_SECRET_KEY=CHANGE_ME
# Set true only when explicitly running the Toss test integration.
TOSS_TOPUP_ENABLED=false

# Optional: send account mails (password reset) to a local Mailpit (docs/mail-infrastructure.md).
# Defaults are localhost:1025. Keep real SMTP credentials here only; never commit them.
MAIL_ENABLED=false
